# ------------------------------------------------------------
# Cheap one-line summary for the menu header (state file only,
# a single `ip` call — deliberately not the full status screen)
# ------------------------------------------------------------
gft_summary() {
  local role
  role="$(cfg_get ROLE)"
  if [ -z "$role" ]; then
    printf '  %snot configured yet%s — choose "Install / reconfigure this server"\n' "$C_Y" "$C_0"
    return 0
  fi
  local link="${C_DIM}down${C_0}"
  gft_gre_dev_exists && link="${C_G}up${C_0}"
  local svc=""
  if is_systemd; then
    if [ "$role" = "iran" ]; then
      service_active frps.service && svc="${C_G}frps running${C_0}" || svc="${C_DIM}frps stopped${C_0}"
    else
      service_active frpc.service && svc="${C_G}frpc running${C_0}" || svc="${C_DIM}frpc stopped${C_0}"
    fi
  fi
  printf '  %s%s%s | this %s ⇄ peer %s | tunnel %s ⇄ %s | port %s\n' \
    "$C_BOLD" "$role" "$C_0" \
    "$(cfg_get LOCAL_PUBLIC_IP)" "$(cfg_get PEER_PUBLIC_IP)" \
    "$(cfg_get GRE_IP_LOCAL)" "$(cfg_get GRE_IP_REMOTE)" \
    "$(cfg_get CTRL_PORT "$GFT_DEFAULT_CTRL_PORT")"
  printf '  link %b | mtu %s ttl %s | ports %s | frp %s | %b\n' \
    "$link" "$(cfg_get TUNNEL_MTU "$GFT_DEFAULT_MTU")" \
    "$(cfg_get TUNNEL_TTL "$GFT_DEFAULT_TTL")" \
    "$(cfg_get TUNNEL_PORTS)" "$(frp_installed_version || echo 'n/a')" "$svc"
  printf '  v%s | %s\n' "$GFT_VERSION" "$GFT_STATE_FILE"
}

_menu_header() {
  # clear without spawning a process
  if [ -t 1 ] && [ "$GFT_MENU_MODE" != "1" ]; then
    printf '\033[2J\033[H'
  fi
  banner
  gft_summary
  printf '\n'
}

cmd_menu() {
  local idx
  # menu() runs in a command substitution (its stdout is the chosen index),
  # so its GFT_MENU_MODE=1 would stay in that subshell. Promote it here so the
  # prompts opened by the menu (set/edit/ports) keep reading from stdin.
  gft_interactive || GFT_MENU_MODE=1
  while :; do
    _menu_header
    idx="$(menu "Choose an action" \
      "Install / reconfigure this server" \
      "Edit tunnel settings" \
      "Change the tunnel port" \
      "Manage tunnelled ports" \
      "Recalculate the best MTU + TTL" \
      "Connectivity test" \
      "Status" \
      "Update gft-TUNNEL from GitHub" \
      "Update frp to the latest release" \
      "Restart the tunnel and frp" \
      "Show logs" \
      "Show configuration" \
      "Firewall rules" \
      "Export the peer's frp config" \
      "Uninstall" \
      "Quit")"
    case "$idx" in
      -1|15) printf '\n'; return 0 ;;
      0)  cmd_install ;;
      1)  cmd_edit ;;
      2)  cmd_set tunnel-port ;;
      3)  cmd_ports_menu ;;
      4)  cmd_optimize ;;
      5)  cmd_test ;;
      6)  cmd_status ;;
      7)  cmd_self_update ;;
      8)  cmd_update_frp ;;
      9)  cmd_restart ;;
      10) cmd_logs ;;
      11) cmd_config ;;
      12) cmd_firewall_menu ;;
      13) cmd_export_peer ;;
      14) cmd_uninstall ;;
    esac
    pause_enter
  done
}

# ------------------------------------------------------------
# Dispatch
# ------------------------------------------------------------
main() {
  parse_opts "$@"
  local cmd="menu"
  if [ "${#PARSE_REST[@]}" -gt 0 ]; then
    cmd="${PARSE_REST[0]}"
    local -a rest=("${PARSE_REST[@]:1}")
    # shellcheck disable=SC2048,SC2086
    set -- ${rest[@]+"${rest[@]}"}
  fi

  case "$cmd" in
    install)      cmd_install "$@" ;;
    edit|settings) cmd_edit "$@" ;;
    set)          cmd_set "$@" ;;
    tunnel-port)  cmd_set tunnel-port "$@" ;;
    status)       cmd_status "$@" ;;
    test)         cmd_test "$@" ;;
    optimize|mtu) cmd_optimize "$@" ;;
    ports)        cmd_ports "$@" ;;
    frp)          cmd_frp "$@" ;;
    update-frp)   cmd_update_frp "$@" ;;
    update|self-update)
      if [ "$GFT_FORCE" = "1" ]; then cmd_self_update --force; else cmd_self_update "$@"; fi
      ;;
    restart|start) cmd_restart "$@" ;;
    logs)         cmd_logs "$@" ;;
    config)       cmd_config "$@" ;;
    export-peer)  cmd_export_peer "$@" ;;
    firewall|fw)  cmd_firewall "$@" ;;
    uninstall|remove) cmd_uninstall "$@" ;;
    service-up)   cmd_service_up "$@" ;;
    service-down) cmd_service_down "$@" ;;
    version|-v)   printf '%s v%s\n' "$GFT_APP_NAME" "$VERSION" ;;
    help|-h|--help) cmd_help ;;
    menu|"")      cmd_menu "$@" ;;
    *)            err "unknown command: $cmd"; printf '\n'; cmd_help; exit 2 ;;
  esac
}

quiet_output_guard
main "$@"
