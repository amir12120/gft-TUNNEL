# ============================================================
# Self update from GitHub
# ============================================================
cmd_self_update() {
  require_root "update"
  local force="${1:-}" dir="$GFT_SELF_DIR" before after newver
  local ref="${GFT_UPDATE_REF:-main}"

  if [ ! -d "$dir/.git" ]; then
    warn "this copy is not a git checkout, so it cannot update itself"
    dim "  reinstall with:"
    dim "  curl -fsSL https://raw.githubusercontent.com/amir12120/gft-TUNNEL/main/install.sh | sudo bash"
    return 1
  fi
  have git || { err "git is required for a self update"; return 1; }

  before="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  info "current revision: ${C_BOLD}${before}${C_0} (v$VERSION)"

  if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ] && [ "$force" != "--force" ]; then
    err "this checkout has local changes — refusing to overwrite them"
    dim "  keep them with: git -C $dir diff > /tmp/gft-local.patch"
    dim "  or force the update with: $GFT_CLI_NAME update --force"
    return 1
  fi

  if ! mutq git -C "$dir" fetch --depth 1 origin "$ref"; then
    err "git fetch failed (no network?)"
    return 1
  fi
  if [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" = "$(git -C "$dir" rev-parse FETCH_HEAD 2>/dev/null)" ]; then
    # --force also restores a dirty tree when we are already up to date
    if [ "$force" = "--force" ] && [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
      mutq git -C "$dir" reset --hard FETCH_HEAD || { err "git reset failed"; return 1; }
      ok "local changes discarded — already on the newest version (v$VERSION)"
      return 0
    fi
    ok "already on the newest version (v$VERSION)"
    return 0
  fi
  if ! mutq git -C "$dir" reset --hard FETCH_HEAD; then
    err "git reset failed"
    return 1
  fi
  after="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  newver="$(head -1 "$GFT_VERSION_FILE" 2>/dev/null)"
  ok "updated ${before} → ${after} (v${newver:-unknown})"

  if cfg_is_set ROLE; then
    step "Refreshing the installed units"
    units_install || true
    units_reload || true
    services_restart_role || true
    ok "services restarted on the new version"
  fi
  dim "  note: the running menu still uses the old code — exit and reopen gft"
  return 0
}

