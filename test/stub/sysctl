#!/usr/bin/env bash
# ============================================================
# test/stub/sysctl — logs every key it is asked to apply
# ============================================================
S="${STUB_TMP:?STUB_TMP is not set}"
mkdir -p "$S"
echo "sysctl $*" >>"$S/sysctl.log"
for a in "$@"; do
  case "$a" in
    *=*) echo "$a" >>"$S/sysctl.applied" ;;
  esac
done
exit 0
