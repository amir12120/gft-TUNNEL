[Unit]
Description=frp server (frps) — gft-TUNNEL relay on the Iranian server
Documentation=https://github.com/fatedier/frp
After=network-online.target gft-tunnel.service
Wants=network-online.target
Requires=gft-tunnel.service

[Service]
Type=simple
User=root
Restart=always
RestartSec=3
ExecStart=__BIN__/frps -c __FRP_ETC__/frps.toml
ExecReload=/bin/kill -HUP $MAINPID
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
